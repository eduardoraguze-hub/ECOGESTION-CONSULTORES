Dialogue: 0,0:00:00.24,0:00:01.58,Sub,,0,0,0,,{\fad(120,80)}SI HOY ALGO NO SALIÓ
Dialogue: 0,0:00:01.60,0:00:03.02,Sub,,0,0,0,,{\fad(120,80)}COMO ESPERABAS…
Dialogue: 0,0:00:03.04,0:00:04.26,Sub,,0,0,0,,{\fad(120,80)}NO ES CASUALIDAD QUE ESTÉS
Dialogue: 0,0:00:04.28,0:00:05.76,Sub,,0,0,0,,{\fad(120,80)}VIENDO ESTO.
Dialogue: 0,0:00:05.82,0:00:06.66,Sub,,0,0,0,,{\fad(120,80)}A VECES
Dialogue: 0,0:00:06.68,0:00:07.98,Sub,,0,0,0,,{\fad(120,80)}CUANDO LAS COSAS NO SALEN
Dialogue: 0,0:00:08.00,0:00:09.10,Sub,,0,0,0,,{\fad(120,80)}COMO ESPERAMOS
Dialogue: 0,0:00:09.12,0:00:10.94,Sub,,0,0,0,,{\fad(120,80)}NOS PREGUNTAMOS POR QUÉ.
Dialogue: 0,0:00:10.96,0:00:11.74,Sub,,0,0,0,,{\fad(120,80)}¿ES QUE {\C&H4FC8FF&}DIOS{\C&HFFFFFF&} NO NOS
Dialogue: 0,0:00:11.76,0:00:12.70,Sub,,0,0,0,,{\fad(120,80)}ESCUCHA?
Dialogue: 0,0:00:12.72,0:00:13.66,Sub,,0,0,0,,{\fad(120,80)}¿O ES QUE EL DESTINO
Dialogue: 0,0:00:13.68,0:00:15.44,Sub,,0,0,0,,{\fad(120,80)}ESTÁ EN NUESTRA CONTRA?
Dialogue: 0,0:00:15.66,0:00:17.70,Sub,,0,0,0,,{\fad(120,80)}{\C&H4FC8FF&}DIOS{\C&HFFFFFF&} TIENE UN {\C&H4FC8FF&}PLAN{\C&HFFFFFF&} {\C&H4FC8FF&}PERFECTO{\C&HFFFFFF&}
Dialogue: 0,0:00:17.72,0:00:19.50,Sub,,0,0,0,,{\fad(120,80)}AUNQUE HOY NO LO ENTIENDAS.
Dialogue: 0,0:00:19.52,0:00:20.50,Sub,,0,0,0,,{\fad(120,80)}LO QUE PARA NOSOTROS ES
Dialogue: 0,0:00:20.52,0:00:22.50,Sub,,0,0,0,,{\fad(120,80)}UN DESVÍO O UN FRACASO
Dialogue: 0,0:00:22.52,0:00:23.50,Sub,,0,0,0,,{\fad(120,80)}PARA ÉL PUEDE SER EL
Dialogue: 0,0:00:23.52,0:00:25.50,Sub,,0,0,0,,{\fad(120,80)}CAMINO CORRECTO HACIA ALGO MUCHO
Dialogue: 0,0:00:25.52,0:00:27.08,Sub,,0,0,0,,{\fad(120,80)}MÁS {\C&H4FC8FF&}GRANDE.{\C&HFFFFFF&}
Dialogue: 0,0:00:27.10,0:00:28.34,Sub,,0,0,0,,{\fad(120,80)}CUANDO ALGO NO SALE COMO
Dialogue: 0,0:00:28.36,0:00:29.34,Sub,,0,0,0,,{\fad(120,80)}LO PLANEASTE
Dialogue: 0,0:00:29.36,0:00:30.06,Sub,,0,0,0,,{\fad(120,80)}NO ES QUE {\C&H4FC8FF&}DIOS{\C&HFFFFFF&} TE
Dialogue: 0,0:00:30.08,0:00:31.46,Sub,,0,0,0,,{\fad(120,80)}ESTÉ QUITANDO ALGO…
Dialogue: 0,0:00:31.48,0:00:32.78,Sub,,0,0,0,,{\fad(120,80)}TE ESTÁ {\C&H4FC8FF&}PREPARANDO{\C&HFFFFFF&} PARA LO
Dialogue: 0,0:00:32.80,0:00:33.66,Sub,,0,0,0,,{\fad(120,80)}QUE VIENE.
Dialogue: 0,0:00:33.68,0:00:35.26,Sub,,0,0,0,,{\fad(120,80)}TE ESTÁ FORTALECIENDO
Dialogue: 0,0:00:35.28,0:00:36.26,Sub,,0,0,0,,{\fad(120,80)}ENSEÑANDO
Dialogue: 0,0:00:36.28,0:00:37.76,Sub,,0,0,0,,{\fad(120,80)}{\C&H4FC8FF&}PULIENDO.{\C&HFFFFFF&}
Dialogue: 0,0:00:37.92,0:00:39.90,Sub,,0,0,0,,{\fad(120,80)}ÉL VE EL PANORAMA COMPLETO.
Dialogue: 0,0:00:39.92,0:00:41.66,Sub,,0,0,0,,{\fad(120,80)}TU TAREA ES CONFIAR
Dialogue: 0,0:00:41.68,0:00:43.42,Sub,,0,0,0,,{\fad(120,80)}SER {\C&H4FC8FF&}PACIENTE{\C&HFFFFFF&} Y SEGUIR DANDO
Dialogue: 0,0:00:43.44,0:00:44.70,Sub,,0,0,0,,{\fad(120,80)}LO MEJOR DE TI EN
Dialogue: 0,0:00:44.72,0:00:45.98,Sub,,0,0,0,,{\fad(120,80)}CADA PASO.
Dialogue: 0,0:00:46.00,0:00:47.42,Sub,,0,0,0,,{\fad(120,80)}NO TE DESANIMES.
Dialogue: 0,0:00:47.44,0:00:48.70,Sub,,0,0,0,,{\fad(120,80)}LO QUE {\C&H4FC8FF&}DIOS{\C&HFFFFFF&} TIENE PREPARADO
Dialogue: 0,0:00:48.72,0:00:51.02,Sub,,0,0,0,,{\fad(120,80)}PARA TI ES {\C&H4FC8FF&}INFINITAMENTE{\C&HFFFFFF&} MEJOR
Dialogue: 0,0:00:51.04,0:00:53.16,Sub,,0,0,0,,{\fad(120,80)}DE LO QUE PUEDES IMAGINAR.
